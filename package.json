{
  "name": "skir-elixir-gen",
  "version": "0.3.0",
  "description": "Native Elixir code generation and SkirRPC support for Skir schemas",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "runtime",
    "docs",
    "scripts",
    "README.md",
    "VERIFICATION.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "generate:fixtures": "node scripts/generate-fixtures.mjs",
    "test:elixir": "npm run generate && cd example && mix deps.get && mix test --cover --warnings-as-errors",
    "test:integration": "node scripts/integration.mjs",
    "check": "node --check src/generator.js && node --check src/naming.js && node --check src/index.js",
    "configure": "node scripts/configure-example.mjs",
    "generate": "npm run configure && cd example && skir gen",
    "test:runtime": "cd runtime && mix deps.get && mix test",
    "test:all": "npm run check && npm run test:coverage && npm run test:integration && npm run test:rpc-parity",
    "test:rpc-parity": "node scripts/rpc-parity.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/*.js test/*.test.mjs"
  },
  "dependencies": {
    "skir-internal": "0.2.21",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "skir": "1.2.22",
    "skir-client": "1.0.19",
    "skir-typescript-gen": "1.0.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mishmish-dev/skir-elixir-gen.git"
  },
  "homepage": "https://github.com/mishmish-dev/skir-elixir-gen#readme",
  "bugs": {
    "url": "https://github.com/mishmish-dev/skir-elixir-gen/issues"
  },
  "keywords": [
    "skir",
    "elixir",
    "codegen",
    "serialization",
    "rpc"
  ]
}
