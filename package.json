{
  "name": "skir-elixir-gen",
  "version": "0.3.0",
  "description": "Native Elixir code generation for Skir schemas",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "docs/RELEASING.md",
    "README.md",
    "VERIFICATION.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/generator.js && node --check src/naming.js && node --check src/index.js",
    "test:all": "npm run check && npm run lint && npm run format:check && npm run test:coverage && npm run test:integration && npm run test:package",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{js,ts}\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"fixtures/*.mjs\" eslint.config.js package.json .prettierrc.json \".github/workflows/*.yml\" && mix format --check-formatted",
    "format": "prettier --write \"src/**/*.{js,ts}\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"fixtures/*.mjs\" eslint.config.js package.json .prettierrc.json \".github/workflows/*.yml\" && mix format",
    "test:package": "node scripts/package-smoke.mjs",
    "configure": "node scripts/configure-example.mjs",
    "generate": "npm run configure && cd example && skir gen",
    "generate:fixtures": "node scripts/generate-fixtures.mjs",
    "test:elixir": "npm run generate && cd example && mix deps.get --check-locked && mix test --cover --warnings-as-errors",
    "test:integration": "node scripts/integration.mjs"
  },
  "dependencies": {
    "skir-internal": "0.2.21",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "skir": "1.2.22",
    "skir-client": "1.0.19",
    "skir-typescript-gen": "1.0.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mishmish-dev/skir-elixir-gen.git"
  },
  "homepage": "https://github.com/mishmish-dev/skir-elixir-gen#readme",
  "bugs": {
    "url": "https://github.com/mishmish-dev/skir-elixir-gen/issues"
  },
  "keywords": [
    "skir",
    "elixir",
    "codegen",
    "serialization",
    "rpc"
  ]
}
